{
  "url": "https://api.mercadopago.com",
  "paths": {
    "/terminals/v1/actions": {
      "post": {
        "tags": [
          "mp-point"
        ],
        "description": {
          "en": "",
          "pt": "",
          "es": "Este endpoint permite crear la orden de impresión por imágenes en el dispositivo point, según la imagen enviada en string base64. En caso de éxito, la solicitud respondera con el estado 201 "
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "required": true,
                    "example": "print",
                    "description": {
                      "en": "",
                      "pt": "",
                      "es": "Indica el tipo de acción que se realizará sobre la terminal"
                    }
                  },
                  "config": {
                    "type": "object",
                    "required": true,
                    "properties": {
                      "point": {
                        "type": "object",
                        "required": true,
                        "properties": {
                          "terminal_id": {
                            "type": "string",
                            "required": true,
                            "example": "NEWLAND_N950__N950NCB1234345545",
                            "description": {
                              "en": "",
                              "pt": "",
                              "es": "ID del dispositivo point en el que se realizará la impresión."
                            }
                          },
                          "subtype": {
                            "type": "string",
                            "required": true,
                            "example": "image",
                            "description": {
                              "en": "",
                              "pt": "",
                              "es": "Indica el tipo de impresión que se realizara en la terminal"
                            }
                          }
                        }
                      }
                    }
                  },
                  "external_reference": {
                    "type": "string",
                    "required": false,
                    "example": "Image01-POS1",
                    "description": {
                      "en": "",
                      "pt": "",
                      "es": "Es referencia externa con la que el integrador puede generar la orden"
                    }
                  },
                  "image_name": {
                    "type": "string",
                    "required": true,
                    "example": "image.png",
                    "description": {
                      "en": "",
                      "pt": "",
                      "es": "Es el nombre de la imagen ha enviar, tiene una longitud máxima de 20 caracteres y se permite únicamente - y _ como caracteres especiales"
                    }
                  },
                  "content": {
                    "type": "string",
                    "required": true,
                    "example": "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAG0lEQVR4nGLaYx3+b70yy938r8svRAMCAAD//zCbBzjtR24AAAAAAElFTkSuQmCC",
                    "description": {
                      "en": "",
                      "pt": "",
                      "es": "Imagen respresentada en formato base64, se soportan los formatos PNG, JPEG y el tamaño de la imagen no debe superar 1MB"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": {
              "es": "Éxito",
              "pt": "Sucesso",
              "en": "Success"
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "cab1cf1e-824f-49d4-bb9d-69f3f77041d8",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Identificador obtenido en la respuesta de creación para la orden de impresión."
                      }
                    },
                    "type": {
                      "type": "string",
                      "example": "print",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Indica el tipo de acción que se realizará sobre la terminal"
                      }
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "point": {
                          "type": "object",
                          "properties": {
                            "terminal_id": {
                              "type": "string",
                              "example": "NEWLAND_N950__N950NCB1234345545",
                              "description": {
                                "en": "",
                                "pt": "",
                                "es": "ID del dispositivo point en el que se realizará la impresión."
                              }
                            },
                            "subtype": {
                              "type": "string",
                              "example": "image",
                              "description": {
                                "en": "",
                                "pt": "",
                                "es": "Indica el tipo de impresión que se realizará en la terminal"
                              }
                            }
                          }
                        }
                      }
                    },
                    "external_reference": {
                      "type": "string",
                      "example": "Image01-POS1",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Es referencia externa con la que el integrador puede generar la orden"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "image_name is required",
                          "description": {
                            "en": "",
                            "es": "El campo image_name no se encuentra en el body de la petición.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "content is required",
                          "description": {
                            "en": "",
                            "es": "El campo content no se encuentra en el body de la petición.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The image_name does not match pattern",
                          "description": {
                            "en": "",
                            "es": "El nombre del archivo no es válido, se permite longitud máxima de 20 caracteres, incluyendo la extensión en formato alfanumérico. Se permite únicamente - y _ como caracteres especiales.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The image_name does not match pattern",
                          "description": {
                            "en": "",
                            "es": "La extensión del campo no es válida, se permite únicamente .png y .jpeg",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The image_name extension does not match the content extension",
                          "description": {
                            "en": "",
                            "es": "La extensión del nombre del archivo no es la misma a la del archivo en codeado en content.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The content file size exceeds the limit 1MB",
                          "description": {
                            "en": "",
                            "es": "El contenido del campo content supera el peso permitido 1MB",
                            "pt": ""
                          }
                        },
                        {
                          "title": "Error decoding base64, the provided base64 string is not valid.",
                          "description": {
                            "en": "",
                            "es": "El encodeado de la imagen en base64 no es correcto",
                            "pt": ""
                          }
                        },
                        {
                          "title": "invalid_token: bad_request",
                          "description": {
                            "en": "",
                            "es": "El token de autenticación no es válido.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Forbidden Error checking device owner",
                          "description": {
                            "en": "",
                            "es": "El dispositivo al que se intenta enviar la solicitud no está asociado al usuario.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "There is already a queued intent for the device",
                          "description": {
                            "en": "",
                            "es": "Ya existe otro intento vinculado al dispositivo.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "500",
                          "description": {
                            "en": "Generic error. Please try submitting the request again.",
                            "es": "Error genérico. Intenta enviar la solicitud nuevamente.",
                            "pt": "Erro genérico. Tente enviar a solicitação novamente."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "title": {
          "en": "Create print",
          "pt": "",
          "es": "Crear impresión"
        }
      }
    },
    "/terminals/v1/actions/action_id": {
      "get": {
        "tags": [
          "mp-point"
        ],
        "description": {
          "en": "",
          "pt": "",
          "es": "Consulta toda la información sobre una impresión utilizando el ID obtenido en la respuesta a su creación. En caso de éxito, la solicitud devolverá una respuesta con el estado 200"
        },
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "description": {
              "en": "",
              "pt": "",
              "es": "ID de la orden, devuelto en la respuesta a la petición para su creación."
            },
            "required": true,
            "schema": {
              "type": "string",
              "example": "cab1cf1e-824f-49d4-bb9d-69f3f77041d8"
            }
          }
        ],
        "responses": {
          "200": {
            "description": {
              "es": "Éxito",
              "pt": "Sucesso",
              "en": "Success"
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "cab1cf1e-824f-49d4-bb9d-69f3f77041d8",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Identificador obtenido en la respuesta de creación para la orden de impresión."
                      }
                    },
                    "type": {
                      "type": "string",
                      "example": "print",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Indica el tipo de acción que se realizará sobre la terminal"
                      }
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "point": {
                          "type": "object",
                          "properties": {
                            "terminal_id": {
                              "type": "string",
                              "example": "NEWLAND_N950__N950NCB1234345545",
                              "description": {
                                "en": "",
                                "pt": "",
                                "es": "ID del dispositivo point en el que se realizará la impresión."
                              }
                            },
                            "subtype": {
                              "type": "string",
                              "example": "image",
                              "description": {
                                "en": "",
                                "pt": "",
                                "es": "Indica el tipo de impresión que se realizará en la terminal"
                              }
                            }
                          }
                        }
                      }
                    },
                    "external_reference": {
                      "type": "string",
                      "example": "Image01-POS1",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Es referencia externa con la que el integrador puede generar la orden"
                      }
                    },
                    "status": {
                       "$ref": "#/components/schemas/status"
                    },
                    "created_at": {
                      "type": "string",
                      "example": "2025-02-06T15:34:18.000+00:00",
                      "description": {
                        "en": "",
                        "pt": "",
                        "es": "Fecha de creación de la orden desde el API"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Intent ID is not valid",
                          "description": {
                            "en": "",
                            "es": "El action_id proporcionado en el path de la petición no es correcto. Compruébalo y proporciona un ID válido para volver a intentarlo.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "unauthorized",
                          "description": {
                            "en": "The value sent as Access Token is incorrect. Please check and try again with the correct value.",
                            "es": "El valor enviado como Access Token es incorrecto. Por favor, verifícalo y vuelve a intentar realizar la peticion enviando el valor correcto.",
                            "pt": "O valor enviado como Access Token está incorreto. Verifique e tente a enviar requisição novamente com o valor correto."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Order not found",
                          "description": {
                            "en": "Order not found. Please check if you provided the correct order ID.",
                            "es": "Orden no encontrada. Comprueba si enviaste el ID correcto.",
                            "pt": "Order não encontrada. Verifique se o ID enviado está correto."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "500",
                          "description": {
                            "en": "Internal server error. Please try submitting the request again.",
                            "es": "Error interno. Intenta enviar la solicitud nuevamente.",
                            "pt": "Erro interno. Tente enviar a solicitação novamente."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "title": {
          "en": "Get print by ID",
          "pt": "Obter impressão por ID",
          "es": "Obtener impresión por ID"
        }
      }
    },
    "/terminals/v1/actions/action_id/cancel": {
      "delete": {
        "tags": [
          "mp-point"
        ],
        "description": {
          "en": "",
          "pt": "",
          "es": "Cancela unaimpresión creada para Mercado Pago Point, utilizando el ID de referencia obtenido en la respuesta a su creación. Sólo puede ser cancelada una order en status \"created\". En caso de éxito, la solicitud devolverá una respuesta con el estado 204"
        },
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "description": {
              "en": "",
              "pt": "",
              "es": "ID de la impresión, devuelta en la respuesta a la petición para su creación."
            },
            "required": true,
            "schema": {
              "type": "string",
              "example": "NEWLAND_N950__N950NCB1234345545"
            }
          }
        ],
        "responses": {
          "204": {
            "description": {
              "en": "Success",
              "es": "Éxito",
              "pt": "Sucesso"
            }
          },
          "401": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "unauthorized",
                          "description": {
                            "en": "The value sent as Access Token is incorrect. Please check and try again with the correct value.",
                            "es": "El valor enviado como Access Token es incorrecto. Por favor, verifícalo y vuelve a intentar realizar la peticion enviando el valor correcto.",
                            "pt": "O valor enviado como Access Token está incorreto. Verifique e tente a enviar requisição novamente com o valor correto."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Not found ",
                          "description": {
                            "en": "",
                            "es": "Orden no encontrada. Comprueba si enviaste el ID correcto.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Conflict Can't update Order ID",
                          "description": {
                            "en": "",
                            "es": "Hay un conflicto al intentar cancelar la orden de impresión por su estado actual. Recuerda que los intentos solo pueden ser cancelados vía API cuando \"status=created\". Si estás intentando cancelar una order con estado \"status=on_terminal\", deberás hacerlo desde la terminal.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "500",
                          "description": {
                            "en": "Internal server error. Please try submitting the request again.",
                            "es": "Error interno. Intenta enviar la solicitud nuevamente.",
                            "pt": "Erro interno. Tente enviar a solicitação novamente."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "title": {
          "en": "",
          "pt": "",
          "es": "Cancelar intento de impresión por ID"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "status": {
        "type": "string",
        "example": "processed",
        "description": {
          "en": "Current status of the order.",
          "pt": "",
          "es": "Estado actual de la orden."
        },
        "enum": [
          {
            "title": "created",
            "description": {
              "en": "",
              "es": "La orden ha sido creado de manera exitosa.",
              "pt": ""
            }
          },
          {
            "title": "on_terminal",
            "description": {
              "en": "",
              "es": "La orden fue obtenida por el dispositivo point y está listo para ser procesado.",
              "pt": ""
            }
          },
          {
            "title": "canceled",
            "description": {
              "en": "",
              "es": "La orden fue cancelada desde el API o desde el point.",
              "pt": ""
            }
          },
          {
            "title": "processed",
            "description": {
              "en": "",
              "es": "La orden fue impresa correctamente en el dispositivo.",
              "pt": ""
            }
          },
          {
            "title": "error",
            "description": {
              "en": "",
              "es": "Se produjo un fallo en el procesamiento de la impresión.",
              "pt": ""
            }
          },
          {
            "title": "expired",
            "description": {
              "en": "",
              "es": "Se desconce si la impresión finalizo correctamente, verifique en el dispositivo point",
              "pt": ""
            }
          }
        ]
      }
    }
  }
}