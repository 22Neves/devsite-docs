{
  "url": "https://api.mercadopago.com",
  "paths": {
    "/point/integration-api/devices/device_id/print": {
      "post": {
        "tags": [
          "mp-point"
        ],
        "description": {
          "en": "",
          "pt": "",
          "es": "Este endpoint permite crear un intento de impresión en el dispositivo point, según la imagen enviada en string base64. En caso de éxito, la solicitud respondera con el estado 201 "
        },
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "description": {
              "en": "",
              "pt": "",
              "es": "ID del dispositivo point en el que se realizará la impresión"
            },
            "required": true,
            "schema": {
              "type": "string",
              "example": "PAX_A910__SMARTPOS1234345545"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_name":{
                    "type":"string",
                    "required":true,
                    "example":"image.png",
                    "description":{
                      "en":"",
                      "pt":"",
                      "es":"Es el nombre de la imagen ha enviar, tiene una longitud máxima de 20 caracteres y se permite únicamente - y _ como caracteres especiales"
                    }
                  },
                  "file_base_64":{
                    "type":"string",
                    "required":true,
                    "example":"iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAG0lEQVR4nGLaYx3+b70yy938r8svRAMCAAD//zCbBzjtR24AAAAAAElFTkSuQmCC",
                    "description":{
                      "en":"",
                      "pt":"",
                      "es":"Imagen respresentada en formato base64, se soportan los formatos PNG, JPEG y el tamaño de la imagen no debe superar 1MB"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": {
              "es": "Éxito",
              "pt": "Sucesso",
              "en": "Success"
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_id":{
                      "type":"string",
                      "example":"PAX_A910__SMARTPOS1234345545",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"ID del dispositivo point en el que se realizará la impresión."
                      }
                    },
                    "file_name":{
                      "type":"string",
                      "example":"image.png",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"Nombre del archivo de la imagen"
                      }
                    },
                    "id":{
                      "type":"string",
                      "example":"cab1cf1e-824f-49d4-bb9d-69f3f77041d8",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"Identificador obtenido en la respuesta de creación del intento de impresión."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "file_name is required",
                          "description": {
                            "en": "",
                            "es": "El campo file_name no se encuentra en el body de la petición.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "file_base_64 is required",
                          "description": {
                            "en": "",
                            "es": "El campo file_base_64 no se encuentra en el body de la petición.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The file_name is not valid",
                          "description": {
                            "en": "",
                            "es": "El nombre del archivo no es válido, se permite longitud máxima de 20 caracteres, incluyendo la extensión en formato alfanumérico. Se permite únicamente - y _ como caracteres especiales.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The file_name extension is not valid",
                          "description": {
                            "en": "",
                            "es": "La extensión del campo no es válida, se permite únicamente .png y .jpeg",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The file_name extension does not match the file_base_64 extension",
                          "description": {
                            "en": "",
                            "es": "La extensión del nombre del archivo no es la misma a la del archivo en codeado en file_base_64.",
                            "pt": ""
                          }
                        },
                        {
                          "title": "The file size exceeds the limit 1MB",
                          "description": {
                            "en": "",
                            "es": "El contenido del campo file base64  supera el peso permitido 1MB",
                            "pt": ""
                          }
                        },
                        {
                          "title": "Error decoding base64, the provided base64 string is not valid.",
                          "description": {
                            "en": "",
                            "es": "El encodeado de la imagen en base64 no es correcto",
                            "pt": ""
                          }
                        },
                        {
                          "title": "invalid_token: bad_request",
                          "description": {
                            "en": "",
                            "es": "El token de autenticación no es válido.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Forbidden Error checking device owner",
                          "description": {
                            "en": "",
                            "es": "El dispositivo al que se intenta enviar la solicitud no está asociado al usuario.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "There is already a queued intent for the device",
                          "description": {
                            "en": "",
                            "es": "Ya existe otro intento vinculado al dispositivo.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "500",
                          "description": {
                            "en": "Generic error. Please try submitting the request again.",
                            "es": "Error genérico. Intenta enviar la solicitud nuevamente.",
                            "pt": "Erro genérico. Tente enviar a solicitação novamente."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "title": {
          "en": "Create print",
          "pt": "",
          "es": "Crear impresión"
        }
      }
    },
    "point/integration-api/print/print_intent_id": {
      "get": {
        "tags": [
          "mp-point"
        ],
        "description": {
          "en": "",
          "pt": "",
          "es": "Consulta toda la información sobre una impresión utilizando el ID obtenido en la respuesta a su creación. En caso de éxito, la solicitud devolverá una respuesta con el estado 200"
        },
        "parameters": [
          {
            "name": "print_intent_id",
            "in": "path",
            "description": {
              "en": "",
              "pt": "print_intent_id",
              "es": "ID del intento, devuelto en la respuesta a la petición para su creación."
            },
            "required": true,
            "schema": {
              "type": "string",
              "example": "cab1cf1e-824f-49d4-bb9d-69f3f77041d8"
            }
          }
        ],
        "responses": {
          "200": {
            "description": {
              "es": "Éxito",
              "pt": "Sucesso",
              "en": "Success"
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_id":{
                      "type":"string",
                      "example":"PAX_A910__SMARTPOS1234345545",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"ID del dispositivo point en el que se realizará la impresión."
                      }
                    },
                    "file_name":{
                      "type":"string",
                      "example":"image.png",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"Nombre del archivo de la imagen."
                      }
                    },
                    "id":{
                      "type":"string",
                      "example":"cab1cf1e-824f-49d4-bb9d-69f3f77041d8",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"Identificador del intento de impresión creado en la solicitud, generado automáticamente por Mercado Pago."
                      }
                    },
                    "state":{
                      "$ref": "#/components/schemas/status"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Intent ID is not valid",
                          "description": {
                            "en": "",
                            "es": "El print_intent_id proporcionado en el path de la petición no es correcto. Compruébalo y proporciona un ID válido para volver a intentarlo.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "unauthorized",
                          "description": {
                            "en": "The value sent as Access Token is incorrect. Please check and try again with the correct value.",
                            "es": "El valor enviado como Access Token es incorrecto. Por favor, verifícalo y vuelve a intentar realizar la peticion enviando el valor correcto.",
                            "pt": "O valor enviado como Access Token está incorreto. Verifique e tente a enviar requisição novamente com o valor correto."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "intent not found",
                          "description": {
                            "en": "Intent not found. Please check if you provided the correct order ID.",
                            "es": "Intento no encontrado. Comprueba si enviaste el ID correcto.",
                            "pt": "Tentativa não encontrada. Verifique se o ID enviado está correto."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "500",
                          "description": {
                            "en": "Internal server error. Please try submitting the request again.",
                            "es": "Error interno. Intenta enviar la solicitud nuevamente.",
                            "pt": "Erro interno. Tente enviar a solicitação novamente."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "title": {
          "en": "Get print by ID",
          "pt": "Obter impressão por ID",
          "es": "Obtener impresión por ID"
        }
      }
    },
    "point/integration-api/devices/device_id/print/print_intent_id":{
      "delete":{
        "tags":[
          "mp-point"
        ],
        "description":{
          "en":"",
          "pt":"",
          "es":"Cancela un intento de impresión creada para Mercado Pago Point, utilizando el ID de referencia obtenido en la respuesta a su creación. Sólo puede ser cancelada una order en status \"OPEN\". En caso de éxito, la solicitud devolverá una respuesta con el estado 200"
        },
        "parameters":[
          {
            "name":"device_id",
            "in":"path",
            "description":{
              "en": "",
              "pt": "",
              "es": "ID del dispositivo point en el que se realizará la impresión"
            },
            "required":true,
            "schema":{
              "type":"string",
              "example": "PAX_A910__SMARTPOS1234345545"
            }
          },
          {
            "name":"print_intent_id",
            "in":"path",
            "description":{
              "en": "",
              "pt": "",
              "es": "ID del intento, devuelto en la respuesta a la petición para su creación."
            },
            "required":true,
            "schema":{
              "type":"string",
              "example": "cab1cf1e-824f-49d4-bb9d-69f3f77041d8"
            }
          }
        ],
        "responses":{
          "200": {
            "description": {
              "en": "Success",
              "es": "Éxito",
              "pt": "Sucesso" 
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id":{
                      "type":"string",
                      "example":"cab1cf1e-824f-49d4-bb9d-69f3f77041d8",
                      "description":{
                        "en":"",
                        "pt":"",
                        "es":"Identificador del intento de impresión cancelado en la solicitud."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "unauthorized",
                          "description": {
                            "en": "The value sent as Access Token is incorrect. Please check and try again with the correct value.",
                            "es": "El valor enviado como Access Token es incorrecto. Por favor, verifícalo y vuelve a intentar realizar la peticion enviando el valor correcto.",
                            "pt": "O valor enviado como Access Token está incorreto. Verifique e tente a enviar requisição novamente com o valor correto."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Not found ",
                          "description": {
                            "en": "",
                            "es": "Intento de impresión no encontrado. Comprueba si enviaste el ID correcto.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content":{
              "application/json":{
                "schema":{
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "Conflict Can't update Intent ID",
                          "description": {
                            "en": "",
                            "es": "Hay un conflicto al intentar cancelar el intento de impresión por su estado actual. Recuerda que los intentos solo pueden ser cancelados vía API cuando \"status=OPEN\". Si estás intentando cancelar una order con estado \"status=ON_TERMINAL\", deberás hacerlo desde la terminal.",
                            "pt": ""
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": {
              "en": "Error.",
              "pt": "Erro.",
              "es": "Error."
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorKey": {
                      "type": "string",
                      "enum": [
                        {
                          "title": "500",
                          "description": {
                            "en": "Internal server error. Please try submitting the request again.",
                            "es": "Error interno. Intenta enviar la solicitud nuevamente.",
                            "pt": "Erro interno. Tente enviar a solicitação novamente."
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "title": {
          "en": "",
          "pt": "",
          "es": "Cancelar intento de impresión por ID"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "status":{
        "type":"string",
        "example":"FINISHED",
        "description":{
          "en":"Current status of the intent.",
          "pt":"Status atual da tentativa",
          "es":"Estado actual del intento."
        },
        "enum": [
          {
            "title": "OPEN",
            "description": {
              "en": "",
              "es": "El intento ha sido creado de manera exitosa.",
              "pt": ""
            }
          },
          {
            "title": "ON_TERMINAL",
            "description": {
              "en": "",
              "es": "El intento fue obtenido por el dispositivo point y está listo para ser procesado.",
              "pt": ""
            }
          },
          {
            "title": "CANCELED",
            "description": {
              "en": "",
              "es": "El intento fue cancelado desde el API o desde el point.",
              "pt": ""
            }
          },
          {
            "title": "FINISHED",
            "description": {
              "en": "",
              "es": "El intento se imprimio correctamente en el dispositivo.",
              "pt": ""
            }
          },
          {
            "title": "ERROR",
            "description": {
              "en": "",
              "es": "Se produjo un fallo en el procesamiento de la impresión.",
              "pt": ""
            }
          },
          {
            "title": "CONFIRMATION_REQUIRED",
            "description": {
              "en": "",
              "es": "Se desconce si la impresión finalizo correctamente, verifique en el dispositivo point",
              "pt": ""
            }
          }
        ]
      }
    }
  }
}